{
  "name": "sanskriti-backend",
  "version": "1.0.0",
  "description": "Backend API for Sanskriti Admin & Customer Panel",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/app.js",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:skip-failed": "prisma migrate resolve --applied 20260207190316_add_order_status || true",
    "start:migrate": "npm run migrate:skip-failed && prisma migrate deploy && node dist/app.js",
    "start:dbpush": "prisma db push --accept-data-loss && node dist/app.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "fix-migration-applied": "prisma migrate resolve --applied 20260129180605_add_userid_to_bill",
    "fix-migration-rollback": "prisma migrate resolve --rolled-back 20260129180605_add_userid_to_bill"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "puppeteer": "^24.36.1",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  userId        String   @unique
  name          String
  password      String
  role          Role     @default(CUSTOMER)
  walletBalance Float    @default(0)
  isActive      Boolean  @default(true)
  
  // Company Details (optional, for customers)
  company         String?
  email           String?
  phone           String?
  companyAddress  String?
  state           String?
  pin             String?
  gst             String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

enum Role {
  ADMIN
  CUSTOMER
}

model Order {
  id        String      @id @default(uuid())
  orderId   String      @unique
  userId    String
  skuId     String
  price     Float
  currency  Currency
  platform  Platform
  status    OrderStatus @default(IN_PROGRESS)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([orderId])
}

enum Currency {
  USD
  INR
}

enum Platform {
  Amazon
  Flipkart
  Meesho
  Etsy
}

enum OrderStatus {
  IN_PROGRESS
  SHIPPED
  RTO
}

model Bill {
  id              String   @id @default(uuid())
  transactionId   String   @unique
  invoiceNumber   String?  @unique // Custom Invoice Number (e.g. STA3000)
  transactionDate DateTime @default(now())
  
  // Link to User
  userId          String?
  
  // Company Details
  company         String
  email           String
  phone           String
  companyAddress  String
  state           String
  pin             String
  gst             String
  
  // Payment (Fixed: Razorpay Wallet)
  paymentMode     String   @default("Razorpay Wallet")
  
  // Product Details
  productName     String
  skuId           String
  quantity        Int
  price           Float
  currency        Currency
  shippingCharge  Float
  taxPercent      Float
  
  // Calculated
  payableAmount   Float
  
  // Invoice
  invoiceUrl      String?

  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([transactionId])
  @@index([company])
}

model Transaction {
  id              String   @id @default(uuid())
  transactionId   String   @unique  // TXN-timestamp-RANDOM
  userId          String
  amount          Float
  type            TransactionType   // CREDIT or DEBIT
  status          TransactionStatus // PENDING, SUCCESS, FAILED
  paymentMethod   String            // "TEST_PAYMENT", "RAZORPAY", "ADMIN_CREDIT", etc.
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([transactionId])
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Settings {
  id          String   @id @default(uuid())
  companyPan  String   @default("CANPJ8390R")
  companyGst  String   @default("08CANPJ3390R1ZT")
  updatedAt   DateTime @updatedAt
}
